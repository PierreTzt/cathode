# Copy this file to .env.local (local dev) or .env (Docker), then fill in the
# values. None of these are committed — see .gitignore.

# ---- TMDB (required) ----
# Posters, episode catalogue, genres, cast, streaming providers and search all
# come from TMDB. Without this token the app runs but stays visually empty.
# Get one at https://www.themoviedb.org/settings/api — use the "API Read Access
# Token" (a long JWT starting with eyJ...), not the shorter v3 API key.
TMDB_READ_TOKEN=

# ---- Web Push (optional) ----
# Only needed for push notifications (new episode alerts, weekly recap).
# Generate a key pair with:  npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: or https: URL identifying you.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Sub-path hosting (optional) ----
# Leave empty to serve the app at the root of the domain (the default).
# Set it only if a reverse proxy publishes the app under a sub-path, e.g.
# BASE_PATH=/cathode. With Docker, docker-compose reads it from .env and passes
# it both at build time (it is baked into the assets) and at runtime.
BASE_PATH=
